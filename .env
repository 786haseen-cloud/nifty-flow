DATABASE_URL=file:/home/z/my-project/db/custom.db

# ═══════════════════════════════════════════════════════════
# ZERODHA KITE API
# Setup: https://developers.kite.trade
# 1. Create app at developers.kite.trade/apps
# 2. Get API Key + API Secret
# 3. Generate Access Token via login flow (see below)
# ═══════════════════════════════════════════════════════════
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Access Token refresh:
# Daily: Visit https://kite.zerodha.com/connect/login?api_key=YOUR_API_KEY
# After login, capture request_token from redirect URL
# Then POST to Kite to exchange request_token → access_token
# (We automate this in /api/kite/auth route)

# Chart settings
CHART_UPDATE_INTERVAL_MS=15000
CHART_VISIBLE_BARS=160
CHART_PRICE_HEIGHT=140
CHART_BAR_HEIGHT=72
