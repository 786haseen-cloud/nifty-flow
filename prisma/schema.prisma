generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model KiteConfig {
  id          String   @id @default(cuid())
  apiKey      String
  accessToken String
  lastLogin   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyActivity {
  id             String   @id @default(cuid())
  date           String
  instrument     String
  type           String
  totalOI        Float    @default(0)
  totalVolume    Float    @default(0)
  callOI         Float    @default(0)
  putOI          Float    @default(0)
  pcr            Float    @default(0)
  vixOpen        Float?
  vixClose       Float?
  fiiCashNet     Float    @default(0)
  fiiFutNet      Float    @default(0)
  fiiOptNet      Float    @default(0)
  diiCashNet     Float    @default(0)
  propdeskNet    Float    @default(0)
  clientNet      Float    @default(0)
  signals        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SignalLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  instrument    String
  signalType    String
  mode          String
  confidence    Float
  strike        Float?
  premium       Float?
  stopLoss      Float?
  target        Float?
  reasoning     String?
  createdAt     DateTime @default(now())
}

model BigTrade {
  id          String   @id @default(cuid())
  timestamp   DateTime
  instrument  String
  tradeType   String
  action      String
  player      String
  quantity    Float
  value       Float
  strike      Float?
  createdAt   DateTime @default(now())
}

model InstitutionalFlow {
  id              String   @id @default(cuid())
  date            String
  fiiCashNet      Float    @default(0)
  fiiFutNet       Float    @default(0)
  fiiOptCallNet   Float    @default(0)
  fiiOptPutNet    Float    @default(0)
  diiCashNet      Float    @default(0)
  propdeskCashNet Float    @default(0)
  propdeskFutNet  Float    @default(0)
  propdeskOptNet  Float    @default(0)
  clientCashNet   Float    @default(0)
  clientFutNet    Float    @default(0)
  clientOptNet    Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
